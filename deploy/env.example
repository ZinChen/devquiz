# Copy to /opt/devquiz/.env on the VDS and fill in. Never commit the filled version.
#   install -m 600 /dev/null /opt/devquiz/.env
#
# Generate each secret separately:
#   openssl rand -hex 32              # database passwords
#   docker run --rm ghcr.io/zinchen/devquiz:latest ./bin/rails secret

# --- Postgres (one instance, two databases, two roles) ---------------------
# The DEV_* values are read only when the volume is first created; changing
# them later has no effect unless you alter the role by hand.
POSTGRES_USER=devquiz
POSTGRES_PASSWORD=
POSTGRES_DB=devquiz_production

DEV_DB_USER=devquiz_dev
DEV_DB_PASSWORD=
DEV_DB_NAME=devquiz_dev

# --- Rails ------------------------------------------------------------------
# These two MUST differ, or a session cookie from staging authenticates on prod.
SECRET_KEY_BASE=
DEV_SECRET_KEY_BASE=

# --- OAuth: production ------------------------------------------------------
# Callbacks to register:
#   https://devquiz.zinchenlab.ru/auth/github/callback
#   https://devquiz.zinchenlab.ru/auth/google_oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: staging ---------------------------------------------------------
# A GitHub OAuth App allows exactly one callback URL, so staging needs its own
# app. Google allows several redirect URIs per client — there you may reuse the
# production client and just add the dev callback to it.
#   https://dev.devquiz.zinchenlab.ru/auth/github/callback
#   https://dev.devquiz.zinchenlab.ru/auth/google_oauth2/callback
DEV_GITHUB_CLIENT_ID=
DEV_GITHUB_CLIENT_SECRET=
DEV_GOOGLE_CLIENT_ID=
DEV_GOOGLE_CLIENT_SECRET=
